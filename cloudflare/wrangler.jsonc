{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blau-tiktok-v3",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Sin URLs de preview por versión: evitaría hostnames no cubiertos por la política de Access.
  "preview_urls": false,
  // La web (public/) se empaqueta dentro del Worker en cada build: sin Workers Assets.
  "build": { "command": "node scripts/build-static.mjs" },
  "d1_databases": [{ "binding": "DB", "database_name": "blau-tiktok-v3", "database_id": "0ca77d5d-7f0e-4a43-a5f8-7a04aa04be3c" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "blau-tiktok-private" }],
  // Limpieza diaria: subidas abandonadas, variantes a medias, trabajos sin agente. Cron Triggers entran en el plan Free.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "chef-titus.cloudflareaccess.com",
    "ACCESS_AUD": "a5c3b3409fc2b6b6221e9b59967ac6b59cec1b7ae11cf67a11d0bea1103a298d",
    // OWNER_EMAIL (propietaria/Advanced) y TEAM_EMAILS (equipo) van como SECRETOS para no publicar correos en git:
    //   npx wrangler secret put OWNER_EMAIL   ·   npx wrangler secret put TEAM_EMAILS   (separados por coma)
    "MAX_UPLOAD_BYTES": "4294967296",
    "UPLOADS_PER_HOUR": "40",
    // 0 = no borrar nunca automáticamente. Los originales NUNCA se borran solos.
    "REJECTED_RETENTION_DAYS": "0"
  }
}
