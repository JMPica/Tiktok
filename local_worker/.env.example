# COPY TO .env AND NEVER SHARE OR COMMIT IT.
STUDIO_PUBLIC_URL=https://YOUR_WORKER.YOUR_ACCOUNT.workers.dev
STUDIO_AGENT_TOKEN=SET_AN_INDEPENDENT_RANDOM_64_CHARACTER_SECRET
CF_ACCESS_CLIENT_ID=SET_CLOUDFLARE_ACCESS_SERVICE_TOKEN_CLIENT_ID
CF_ACCESS_CLIENT_SECRET=SET_CLOUDFLARE_ACCESS_SERVICE_TOKEN_CLIENT_SECRET
STUDIO_POLL_SECONDS=45

# Catalan by default; set es for Spanish source speech.
BLAU_DEFAULT_LANGUAGE=ca
# Offline cache or local Whisper model directory (model download on first use)
# BLAU_WHISPER_MODEL_DIR=
BLAU_WHISPER_DEVICE=cpu
BLAU_WHISPER_COMPUTE=int8
