# COPIA A local_worker/.env Y NUNCA LO COMPARTAS NI LO SUBAS A GITHUB.
STUDIO_PUBLIC_URL=https://YOUR_WORKER.YOUR_ACCOUNT.workers.dev
STUDIO_AGENT_TOKEN=SET_AN_INDEPENDENT_RANDOM_64_CHARACTER_SECRET
CF_ACCESS_CLIENT_ID=SET_CLOUDFLARE_ACCESS_SERVICE_TOKEN_CLIENT_ID
CF_ACCESS_CLIENT_SECRET=SET_CLOUDFLARE_ACCESS_SERVICE_TOKEN_CLIENT_SECRET
STUDIO_POLL_SECONDS=45

# Idioma por defecto si el trabajo no lo indica (ca o es).
BLAU_DEFAULT_LANGUAGE=ca

# Transcripción local. Por defecto faster-whisper (modelo "small", ~500 MB, se descarga la primera vez).
# BLAU_WHISPER_MODEL=small          # medium = mejor catalán, más lento; tiny/base = ordenadores modestos
# BLAU_WHISPER_MODEL_DIR=           # carpeta con el modelo ya descargado (sin red)
BLAU_WHISPER_DEVICE=cpu             # cuda si tienes GPU NVIDIA
BLAU_WHISPER_COMPUTE=int8
# Alternativa ONNX (sherpa-onnx): BLAU_ASR_ENGINE=sherpa y BLAU_SHERPA_MODEL_DIR con encoder/decoder/tokens + silero_vad.onnx
# BLAU_ASR_ENGINE=sherpa
# BLAU_SHERPA_MODEL_DIR=

# Opcional: modelo local Ollama para entender peticiones libres de cambio (no se usa si no existe).
# BLAU_OLLAMA_MODEL=qwen2.5:7b-instruct
# BLAU_OLLAMA_URL=http://127.0.0.1:11434

# Opcional: visión semántica local (describe cada plano: acción, personas, emoción, posible clienta/menor).
# Requiere Ollama y un modelo de visión descargado, p. ej.:  ollama pull qwen2.5vl:7b   (GPU o Apple Silicon 16 GB)
# BLAU_VISION_MODEL=qwen2.5vl:7b
# BLAU_VISION_TIMEOUT=180

# Calidad/velocidad del codificador (veryfast = rápido, medium = defecto, slow = mejor compresión).
# BLAU_X264_PRESET=medium
# Carpeta temporal (se borra al acabar cada vídeo).
# BLAU_WORK_DIR=
