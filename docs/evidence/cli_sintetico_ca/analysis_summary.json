   {
    "start": 3.014,
    "end": 7.298,
    "text": "A Ui Ui senceria em compre parem la carina l'ans la cara t'acat"
   },
   {
    "start": 8.166,
    "end": 10.946,
    "text": "I a mi, la tenen totes les superfícies."
   },
   {
    "start": 11.974,
    "end": 16.29,
    "text": "Ves prezes calfamres tu va llores, per què el client estigui com una?"
   },
   {
    "start": 19.43,
    "end": 23.522,
    "text": "I sabeu qui és el secret. La música i la llum."
   },
   {
    "start": 24.934,
    "end": 28.066,
    "text": "I mai, mai, ho livem el cafè de la Marta."
   }
  ]
