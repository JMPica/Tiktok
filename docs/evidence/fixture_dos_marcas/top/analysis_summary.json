    "start": 2.022,
    "end": 6.274,
    "text": "Saps per què alguns tilos poten menys els portals sense vendre?"
   },
   {
    "start": 7.974,
    "end": 11.458,
    "text": "Preu de sotina no sotm'una, valoració real del barri."
   },
   {
    "start": 12.87,
    "end": 15.874,
    "text": "Elles fotos no expliquen com es viu a la casa."
   },
   {
    "start": 16.998,
    "end": 20.898,
    "text": "I show el primer passembre és una bona valoració, és la clau."
   },
   {
    "start": 28.358,
    "end": 33.058,
    "text": "que vius al mar és macuan, mai xus la pla de vans, la n'ha t'avala."
   },
   {
    "start": 34.022,
    "end": 37.57,
    "text": "1, el mercat, el lliçat, el pla, el cap de semana."
   },
   {
    "start": 38.534,
    "end": 43.842,
    "text": "Al final, viure aquí és de niç de mar a 5 minuts i preixon-se la lletana."
   }
  ]
