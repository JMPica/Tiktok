# MODO CERO EUROS. Copiar a .env local, no subir a GitHub.
# Hasta tener frontend/login independentes, solo para pruebas locales.
STUDIO_ORIGIN=http://localhost:5173
# Generar en terminal con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STUDIO_JWT_SECRET=REEMPLAZAR_POR_CLAVE_ALEATORIA_DE_48_CARACTERES_O_MAS
STUDIO_DATA_DIR=/data
STUDIO_MAX_UPLOAD_BYTES=2147483648
GENERATIVE_EFFECTS_ENABLED=false
PUBLISHING_ENABLED=false
BILLABLE_PROVIDERS_ENABLED=false
# HARD CAP: 0€ a proveedores externos; ninguna llamada de pago.
MONTHLY_GENERATIVE_BUDGET_EUR=0
